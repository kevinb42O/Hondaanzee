# Planning template for the future admin implementation.
# These names are not all wired into the application yet.
# Put actual LOCAL secrets in .env.local, which is ignored by Git.
# Configure production secrets in Vercel / Supabase secret management.
# Never prefix server secrets with VITE_ or commit populated values.

# Existing production Supabase project. Metadata/content only; no image storage.
SUPABASE_URL=https://zpllibfxaizavcvztnut.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: private staging and public verified media.
R2_ACCOUNT_ID=
# EU buckets require the EU S3 endpoint, not the default account endpoint.
R2_S3_ENDPOINT=https://f066c9835dfd45eb7d23db73b9beaff9.eu.r2.cloudflarestorage.com
R2_UPLOAD_BUCKET=hondaanzee-uploads
R2_MEDIA_BUCKET=hondaanzee-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.hondaanzee.be

# Project-scoped publication and deployment-status access.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Supplied to a build by the publication workflow, not a permanent live pointer.
HAZ_RELEASE_ID=

# Temporary local build access only. Never deploy this management token.
SUPABASE_ACCESS_TOKEN=
